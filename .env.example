# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garden_planner?schema=public"

# Auth0 API configuration
AUTH0_DOMAIN="your-tenant.au.auth0.com"
AUTH0_AUDIENCE="https://garden-planner-api"
AUTH0_ISSUER="https://your-tenant.au.auth0.com/"

# Optional; defaults to 3000
PORT=3000
